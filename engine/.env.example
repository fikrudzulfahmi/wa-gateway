# =====================================================================
#  CONTOH konfigurasi engine — SALIN menjadi `engine/.env` di server tujuan.
#  Berkas `.env` yang asli TIDAK di-commit (berisi token & kredensial DB).
#
#  Di server baru:
#     cd engine
#     cp .env.example .env
#     (lalu sesuaikan DB + token di bawah)
#     npm install --allow-git=all          # WAJIB: dependensi git (libsignal)
#     npm install @whiskeysockets/baileys@6.7.24
#     node src/index.js                     # atau start-gateway.bat
# =====================================================================

# --- HTTP engine (hanya untuk localhost / dashboard XAMPP) ---
ENGINE_HOST=127.0.0.1
ENGINE_PORT=3001
# Biarkan KOSONG = token dibuat otomatis saat start dan disimpan ke database
# (wa_settings.engine_token), lalu dashboard membacanya.
ENGINE_TOKEN=

# --- MySQL XAMPP ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wa_gateway

# --- Perilaku pengiriman ---
SEND_DELAY_MIN=3
SEND_DELAY_MAX=8
WORKER_TICK=2
PULL_INTERVAL=10
PULL_ACK=1

# --- Log ---
LOG_LEVEL=info
